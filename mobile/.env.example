# ─── Clerk (OBLIGATOIRE) ──────────────────────────────────────────────
# Même clé publique que NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY côté web
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# ─── URL publique du backend Kamforms ────────────────────────────────
# L'API REST exposée par kamforms.com (Next.js)
EXPO_PUBLIC_API_URL=https://kamforms.com

# ─── Sentry (OPTIONNEL — monitoring erreurs) ──────────────────────────
# Laisser vide pour désactiver. Renseigner le DSN Sentry (projet "kamforms-mobile")
# pour activer la capture des crashes en production.
EXPO_PUBLIC_SENTRY_DSN=

# ─── Fichiers Firebase (déjà présents à la racine) ────────────────────
# google-services.json     → notifications push Android (FCM)
# GoogleService-Info.plist → notifications push iOS (APNs)
