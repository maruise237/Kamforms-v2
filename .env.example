# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/kamforms"

# Clerk — authentification (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# URL publique de l'application (utilisée pour les liens dans les notifications)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# DeepSeek — génération de formulaires par IA (https://platform.deepseek.com)
DEEPSEEK_API_KEY="sk-..."

# Evolution API — notifications WhatsApp (optionnel)
EVOLUTION_API_URL="https://votre-instance.evolution-api.com"
EVOLUTION_API_KEY="votre-api-key"
EVOLUTION_INSTANCE_NAME="votre-instance"

# Plunk — notifications email (https://docs.useplunk.com)
# Obtenez votre clé secrète (sk_*) depuis Settings → API Keys dans le dashboard Plunk
PLUNK_SECRET_KEY="sk_..."
EMAIL_FROM="Kamforms <noreply@votredomaine.com>"

# GeniusPay — checkout paiements (https://pay.genius.ci/docs/api)
# Garder ces clés uniquement côté serveur.
GENIUSPAY_API_KEY="pk_sandbox_..."
GENIUSPAY_API_SECRET="sk_sandbox_..."
# URL webhook a renseigner dans GeniusPay:
# https://votre-domaine.com/api/webhooks/geniuspay
GENIUSPAY_WEBHOOK_SECRET="whsec_sandbox_..."

# Analytics — tracking côté client (scripts injectés dans le HTML)
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL="https://votre-analytics.com/script.js"
NEXT_PUBLIC_ANALYTICS_RECORDER_URL="https://votre-analytics.com/recorder.js"
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Analytics — API côté serveur (lecture des stats dans le dashboard)
UMAMI_URL="https://votre-analytics.com"
UMAMI_WEBSITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
UMAMI_USERNAME="votre-username"
UMAMI_PASSWORD="votre-password"
# UMAMI_API_KEY="votre-api-key"  # alternative à username/password

# Dossier de stockage des images uploadées (optionnel, défaut: ./uploads)
# UPLOAD_DIR="/chemin/vers/uploads"

# Redis — rate limiting partagé entre instances (optionnel, fallback in-memory si absent)
# En production via docker-compose: redis://redis:6379
# En local si Redis installé: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# Cron jobs — sécurisation des endpoints /api/cron/* (générer avec: openssl rand -hex 32)
CRON_SECRET="secret-long-aleatoire"

# Admin interne - route cachee + allowlist email Clerk
# Ne pas mettre le vrai slug dans le code, la navigation publique ou le sitemap.
ADMIN_SECRET_PATH="votre-slug-admin-long-et-prive"
ADMIN_EMAILS="admin@votredomaine.com"

# Sentry — monitoring des erreurs (optionnel, https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN="https://xxxx@oyyy.ingest.sentry.io/zzz"
# SENTRY_AUTH_TOKEN="sntrys_..."   # pour uploader les source maps (CI/CD)
# SENTRY_ORG="kamtech-ww"
# SENTRY_PROJECT="javascript-nextjs"
